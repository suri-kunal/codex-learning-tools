{
  "description": "Write opted-in Codex conversation turns, questions, and quizzes to Markdown",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/md-log-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__education_tools__(ask_user_question|quiz|markdown_log_start|markdown_log_stop)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/md-log-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/md-log-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
